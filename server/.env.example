# --- Server Environment Configuration ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini AI (Server-side only — never expose to frontend)
GEMINI_API_KEY=your-gemini-api-key

# Transactional Email (Resend or SMTP)
EMAIL_PROVIDER_API_KEY=your-email-api-key
EMAIL_FROM=compliance@nudge.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Webhook & Job Security Tokens
INBOUND_WEBHOOK_SECRET=nudge_inbound_secret_token_12345
SCHEDULED_JOB_SECRET=nudge_job_secret_token_67890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
